#!/bin/bash
set -euo pipefail

BORG_REPO={{ borgbackup_repository | quote }}
BORG_PASSPHRASE={{ borgbackup_encryption_passphrase | quote }}
ARCHIVE_NAME={{ (inventory_hostname ~ '-' ~ borgbackup_archive_name) | quote }}
export BORG_PASSPHRASE
sources=(
{% for source_path in borgbackup_source_paths %}
    {{ source_path | quote }}
{% endfor %}
)
borg create --verbose --stats "${BORG_REPO}::${ARCHIVE_NAME}" "${sources[@]}"
borg prune --list "${BORG_REPO}" \
    --keep-daily={{ borgbackup_keep_daily | int }} \
    --keep-weekly={{ borgbackup_keep_weekly | int }} \
    --keep-monthly={{ borgbackup_keep_monthly | int }}
unset BORG_PASSPHRASE
